{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tool/agent_commit_guard.py\"",
            "timeout": 30,
            "statusMessage": "커밋 가드 확인"
          }
        ]
      }
    ]
  }
}
